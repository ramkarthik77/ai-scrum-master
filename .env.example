# --- GitHub (CLI / Action) ---
# Optional: otherwise use `scrum-agent login`
GITHUB_TOKEN=
# GitHub Enterprise Server only:
# GITHUB_API_URL=https://ghe.example.com/api/v3
# GITHUB_WEB_URL=https://ghe.example.com

# --- LLM (default Claude) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SCRUM_AGENT_MODEL=anthropic:claude-sonnet-5-5   # or openai:gpt-4o

# --- Web app ---
# GitHub OAuth App: Settings > Developer settings > OAuth Apps
#   Homepage URL: $PUBLIC_URL    Callback URL: $PUBLIC_URL/auth/callback
#   Tick "Enable Device Flow" to also use it for `scrum-agent login --web`
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PUBLIC_URL=http://127.0.0.1:8000
ALLOW_TOKEN_LOGIN=true
SESSION_TTL_HOURS=8
